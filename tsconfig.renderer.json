{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/renderer-check",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": ["src/renderer/**/*.ts", "src/shared/**/*.ts", "src/preload/**/*.ts"]
}
